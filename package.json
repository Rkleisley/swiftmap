{
  "name": "swiftmap-core",
  "version": "0.2.0",
  "description": "High-performance Leaflet + WebGL map rendering core, usable standalone or via the swiftmap Python widget",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./anywidget": "./dist/anywidget.js"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "wheel": "node build.mjs && python -m build --outdir pydist",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:unit": "node --test test/tier1-logic.test.mjs test/tier2-sidebar.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.62.1"
  }
}
