{
  "name": "swiftmap-core",
  "version": "0.5.1",
  "description": "High-performance Leaflet + WebGL map rendering core, usable standalone or via the swiftmap Python widget",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./anywidget": "./dist/anywidget.js",
    "./react": "./dist/react.js",
    "./swiftmap.css": "./dist/swiftmap.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node build.mjs",
    "build:watch": "node build.mjs --watch",
    "wheel": "node build.mjs && python -m build --outdir pydist",
    "test": "node --test",
    "test:watch": "node --test --watch",
    "test:unit": "node --test test/tier1-logic.test.mjs test/tier2-sidebar.test.mjs",
    "stage:npm": "node scripts/stage-npm.mjs",
    "publish:npm": "node build.mjs && node scripts/stage-npm.mjs && npm publish ./npmpkg"
  },
  "devDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "leaflet": "^1.9.4",
    "leaflet.glify": "^3.3.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "streamlit-component-lib": "^2.0.0"
  },
  "peerDependencies": {
    "@geoman-io/leaflet-geoman-free": "^2.18.3",
    "leaflet": "^1.9.4",
    "leaflet.glify": "^3.3.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
